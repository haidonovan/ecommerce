generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CLIENT
  ADMIN
  CASHIER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PREPARING
  READY
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum SalesChannel {
  POS
  ONLINE
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  SALE
  RETURN
  CANCELLATION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  STOCK_CHANGE
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponAudience {
  EVERYONE
  USER
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           UserRole        @default(CLIENT)
  name           String?
  avatarUrl      String?
  orders         Order[]
  favorites      Favorite[]
  comments       Comment[]
  supportTickets SupportTicket[]
  supportReplies SupportMessage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Product {
  id              String         @id @default(cuid())
  name            String
  sku             String?
  barcode         String?
  brand           String?
  category        String
  description     String
  price           Decimal        @db.Decimal(10, 2)
  costPrice       Decimal?       @db.Decimal(10, 2)
  wholesalePrice  Decimal?       @db.Decimal(10, 2)
  discountPercent Int            @default(0)
  discountStart   DateTime?
  discountEnd     DateTime?
  imageUrl        String
  stock           Int            @default(0)
  minStockAlert   Int            @default(5)
  isActive        Boolean        @default(true)
  ratingAvg       Decimal        @default(0) @db.Decimal(3, 2)
  ratingCount     Int            @default(0)
  orderLines      OrderLine[]
  saleItems       SaleItem[]
  movements       InventoryMovement[]
  favorites       Favorite[]
  comments        Comment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([sku])
  @@unique([barcode])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                String       @id @default(cuid())
  userId            String
  channel           SalesChannel @default(ONLINE)
  shippingAddress   String
  paymentMethod     String
  subtotal          Decimal      @db.Decimal(10, 2)
  total             Decimal      @db.Decimal(10, 2)
  status            OrderStatus  @default(PENDING)
  trackingNumber    String?
  trackingCarrier   String?
  trackingStatus    String?
  trackingUpdatedAt DateTime?
  couponCode        String?
  couponType        CouponType?
  couponValue       Decimal?     @db.Decimal(10, 2)
  couponDiscount    Decimal?     @db.Decimal(10, 2)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines             OrderLine[]
  movements         InventoryMovement[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([channel, status, createdAt])
}

model OrderLine {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 2)
  discountPercent Int      @default(0)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Coupon {
  id          String         @id @default(cuid())
  code        String         @unique
  type        CouponType
  value       Decimal        @db.Decimal(10, 2)
  audience    CouponAudience @default(EVERYONE)
  userEmail   String?
  description String?
  isActive    Boolean        @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  productId String
  userId    String
  message   String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  subject   String
  status    String           @default("open")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model Sale {
  id            String       @id @default(cuid())
  channel       SalesChannel @default(POS)
  cashierUserId String?
  cashierName   String?
  customerId    String?
  subtotal      Decimal      @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2)
  tax           Decimal      @default(0) @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  currency      String       @default("USD")
  synced        Boolean      @default(true)
  items         SaleItem[]
  payments      Payment[]
  movements     InventoryMovement[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([channel, createdAt])
  @@index([cashierUserId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  name      String
  sku       String?
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  note      String?
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String
  method    String
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  reference String?
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  orderId       String?
  saleId        String?
  type          InventoryMovementType
  channel       SalesChannel
  quantity      Int
  previousStock Int
  nextStock     Int
  note          String?
  userId        String?
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sale          Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([channel, type, createdAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  createdAt DateTime    @default(now())

  @@index([module, createdAt])
  @@index([userId, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
