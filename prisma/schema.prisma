generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// Enums
// ==========================================

enum UserRole {
  CLIENT
  ADMIN
  CASHIER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PICKING
  PACKING
  READY
  COMPLETED
  CANCELLED
  PROCESSING
  PREPARING
  SHIPPED
  DELIVERED
}

enum SalesChannel {
  POS
  ONLINE
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  SALE
  RETURN
  CANCELLATION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  STOCK_CHANGE
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponAudience {
  EVERYONE
  USER
}

// ==========================================
// 1. Core & Branch Management
// ==========================================

model Branch {
  id                   String                 @id @default(cuid())
  code                 String                 @unique
  name                 String
  phone                String
  address              String
  status               String                 @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  users                User[]
  inventory            Inventory[]
  inventoryBatches     InventoryBatch[]
  sales                Sale[]
  orders               Order[]
  shifts               Shift[]
  payments             Payment[]
  credits              CustomerCredit[]
  containerTx          ContainerTransaction[]
  purchaseOrders       PurchaseOrder[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  role           UserRole          @default(CLIENT)
  roleId         String?
  branchId       String?
  name           String?
  avatarUrl      String?
  roleRef        Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders         Order[]
  favorites      Favorite[]
  comments       Comment[]
  supportTickets SupportTicket[]
  supportReplies SupportMessage[]
  shifts         Shift[]
  goodsReceipts  GoodsReceipt[]
  auditLogs      AuditLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // e.g., "ADMIN", "CASHIER", "CLIENT"
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique // e.g., "pos:sales", "inventory:adjust"
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ==========================================
// 2. Product Catalog
// ==========================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String              @id @default(cuid())
  name            String
  nameKh          String?
  sku             String?             @unique
  barcode         String?             @unique
  brand           String?             // Keep for backward compatibility
  category        String              // Keep for backward compatibility
  categoryId      String?
  brandId         String?
  description     String
  price           Decimal             @db.Decimal(10, 2)
  costPrice       Decimal?            @db.Decimal(10, 2)
  wholesalePrice  Decimal?            @db.Decimal(10, 2)
  vipPrice        Decimal?            @db.Decimal(10, 2)
  discountPercent Int                 @default(0)
  discountStart   DateTime?
  discountEnd     DateTime?
  imageUrl        String
  stock           Int                 @default(0) // Global stock fallback
  minStockAlert   Int                 @default(5)
  isActive        Boolean             @default(true)
  ratingAvg       Decimal             @default(0) @db.Decimal(3, 2)
  ratingCount     Int                 @default(0)
  categoryRef     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandRef        Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  priceTiers      ProductPriceTier[]
  deposits        ProductDeposit[]
  inventory       Inventory[]
  batches         InventoryBatch[]
  orderLines      OrderLine[]
  saleItems       SaleItem[]
  poItems         PurchaseOrderItem[]
  movements       InventoryMovement[]
  favorites       Favorite[]
  comments        Comment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String   @unique
  barcode   String?  @unique
  price     Decimal  @db.Decimal(10, 2)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPriceTier {
  id         String   @id @default(cuid())
  productId  String
  minQty     Int      @default(1)
  tierPrice  Decimal  @db.Decimal(10, 2)
  custTypeId String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. Deposit System & Container Tracking
// ==========================================

model DepositType {
  id              String                 @id @default(cuid())
  name            String                 @unique // e.g., "Bottle", "Crate", "Water Gallon"
  description     String?
  productDeposits ProductDeposit[]
  containerTx     ContainerTransaction[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model ProductDeposit {
  id            String      @id @default(cuid())
  productId     String
  depositTypeId String
  quantity      Int         @default(1)
  depositAmount Decimal     @db.Decimal(10, 2)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  depositType   DepositType @relation(fields: [depositTypeId], references: [id])
}

model ContainerTransaction {
  id            String      @id @default(cuid())
  customerId    String
  depositTypeId String
  branchId      String?
  saleId        String?
  type          String      // "ISSUE" | "RETURN"
  quantity      Int
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  depositType   DepositType @relation(fields: [depositTypeId], references: [id], onDelete: Restrict)
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
}

// ==========================================
// 4. Inventory Control
// ==========================================

model Inventory {
  id        String  @id @default(cuid())
  productId String
  branchId  String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
}

model InventoryBatch {
  id              String              @id @default(cuid())
  productId       String
  branchId        String
  batchNumber     String
  qty             Int                 @default(0)
  initialQty      Int                 @default(0)
  costPrice       Decimal             @default(0) @db.Decimal(10, 2)
  expiryDate      DateTime
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements       InventoryMovement[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([expiryDate])
  @@index([productId, branchId, expiryDate])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  branchId      String?
  batchId       String?
  orderId       String?
  saleId        String?
  type          InventoryMovementType
  channel       SalesChannel
  quantity      Int
  previousStock Int
  nextStock     Int
  note          String?
  userId        String?
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch         InventoryBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sale          Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([channel, type, createdAt])
}

// ==========================================
// 5. Procurement & Supplier Management
// ==========================================

model Supplier {
  id             String          @id @default(cuid())
  name           String
  phone          String
  email          String?
  address        String?
  status         String          @default("ACTIVE")
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  supplierId  String
  branchId    String
  status      String              @default("PENDING") // "PENDING" | "APPROVED" | "RECEIVED" | "CANCELLED"
  totalAmount Decimal             @db.Decimal(10, 2)
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  costPrice       Decimal       @db.Decimal(10, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  purchaseOrderId String
  receivedById    String
  receivedDate    DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy      User          @relation(fields: [receivedById], references: [id])
}

// ==========================================
// 6. Sales, Orders, & Operations
// ==========================================

model Sale {
  id            String       @id @default(cuid())
  channel       SalesChannel @default(POS)
  branchId      String?
  cashierUserId String?
  cashierName   String?
  customerId    String?
  shiftId       String?
  subtotal      Decimal      @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2)
  tax           Decimal      @default(0) @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  currency      String       @default("USD")
  synced        Boolean      @default(true)
  branch        Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shift         Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  payments      Payment[]
  returns       Return[]
  movements     InventoryMovement[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([channel, createdAt])
  @@index([cashierUserId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  name      String
  sku       String?
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  note      String?
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Order {
  id                String               @id @default(cuid())
  userId            String
  customerId        String?
  branchId          String?
  channel           SalesChannel         @default(ONLINE)
  shippingAddress   String
  paymentMethod     String               @default("Cash on delivery")
  subtotal          Decimal              @db.Decimal(10, 2)
  total             Decimal              @db.Decimal(10, 2)
  status            OrderStatus          @default(PENDING)
  trackingNumber    String?
  trackingCarrier   String?
  trackingStatus    String?
  trackingUpdatedAt DateTime?
  couponCode        String?
  couponType        CouponType?
  couponValue       Decimal?             @db.Decimal(10, 2)
  couponDiscount    Decimal?             @db.Decimal(10, 2)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branch            Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines             OrderLine[]
  movements         InventoryMovement[]
  history           OrderStatusHistory[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([channel, status, createdAt])
}

model OrderLine {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 2)
  discountPercent Int      @default(0)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String?
  note      String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ==========================================
// 7. Payments & Configurable Payment Methods
// ==========================================

model PaymentMethod {
  id       String    @id @default(cuid())
  name     String    @unique // e.g., "Cash", "KHQR", "Bank Transfer", "Customer Credit"
  active   Boolean   @default(true)
  payments Payment[]
}

model Payment {
  id              String         @id @default(cuid())
  saleId          String
  paymentMethodId String?
  method          String         // Keep for backward compatibility
  branchId        String?
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("USD")
  reference       String?
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
}

// ==========================================
// 8. Customer Profile & Credit Management
// ==========================================

model CustomerType {
  id        String     @id @default(cuid())
  name      String     @unique // "RETAIL" | "WHOLESALE" | "VIP"
  customers Customer[]
}

model Customer {
  id             String                 @id @default(cuid())
  name           String
  phone          String                 @unique
  email          String?
  customerTypeId String
  creditLimit    Decimal                @default(0.00) @db.Decimal(10, 2)
  creditBalance  Decimal                @default(0.00) @db.Decimal(10, 2)
  customerType   CustomerType           @relation(fields: [customerTypeId], references: [id])
  addresses      CustomerAddress[]
  notes          CustomerNote[]
  credits        CustomerCredit[]
  containerTx    ContainerTransaction[]
  sales          Sale[]
  orders         Order[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  address    String
  isDefault  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  note       String
  cashierId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model CustomerCredit {
  id         String   @id @default(cuid())
  customerId String
  branchId   String?
  saleId     String?
  type       String   // "CHARGE" | "PAYMENT"
  amount     Decimal  @db.Decimal(10, 2)
  balance    Decimal  @db.Decimal(10, 2)
  note       String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

// ==========================================
// 9. Shifts & Returns
// ==========================================

model Shift {
  id          String    @id @default(cuid())
  cashierId   String
  branchId    String?
  openTime    DateTime  @default(now())
  closeTime   DateTime?
  startCash   Decimal   @db.Decimal(10, 2)
  endCashCalc Decimal?  @db.Decimal(10, 2)
  endCashPhys Decimal?  @db.Decimal(10, 2)
  discrepancy Decimal?  @db.Decimal(10, 2)
  status      String    @default("OPEN") // "OPEN" | "CLOSED"
  sales       Sale[]
  user        User      @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model Return {
  id         String       @id @default(cuid())
  saleId     String
  cashierId  String
  totalSaved Decimal      @db.Decimal(10, 2)
  items      ReturnItem[]
  refunds    Refund[]
  sale       Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  returnRef Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Refund {
  id            String   @id @default(cuid())
  returnId      String
  paymentMethod String
  amount        Decimal  @db.Decimal(10, 2)
  returnRef     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

// ==========================================
// 10. Audit, Configuration & Peripherals
// ==========================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id          String         @id @default(cuid())
  code        String         @unique
  type        CouponType
  value       Decimal        @db.Decimal(10, 2)
  audience    CouponAudience @default(EVERYONE)
  userEmail   String?
  description String?
  isActive    Boolean        @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  productId String
  userId    String
  message   String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  subject   String
  status    String           @default("open")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([module, createdAt])
  @@index([userId, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id           String   @id @default(cuid())
  usdToKhrRate Int      @default(4000)
  updatedAt    DateTime @updatedAt
}
